{
  "name": "contributte/syntax-fixtures",
  "description": "Golden files for specs/SYNTAX.md (dialect A)",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "nette/di": "^3.2.0",
    "nette/schema": "^1.3.0",
    "tracy/tracy": "^2.10.0"
  },
  "require-dev": {
    "contributte/qa": "^0.4.0",
    "contributte/phpstan": "^0.2.0",
    "contributte/tester": "^0.4.0"
  },
  "autoload": {
    "psr-4": {
      "Contributte\\Foo\\": "src"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
