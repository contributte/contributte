{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contributte.org/schemas/readme-evaluation-result-1.0.json",
  "title": "Contributte README evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "standardVersion",
    "profile",
    "repositoryRoot",
    "readmePath",
    "status",
    "summary",
    "quality",
    "findings"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "standardVersion": { "const": "0.1-draft" },
    "profile": { "enum": ["library", "skeleton", "deprecated"] },
    "repositoryRoot": { "type": "string", "minLength": 1 },
    "readmePath": { "type": "string", "minLength": 1 },
    "status": { "enum": ["blocked", "incomplete"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "unassessed", "notApplicable"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "unassessed": { "type": "integer", "minimum": 0 },
        "notApplicable": { "type": "integer", "minimum": 0 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "assessmentCoverage", "reason"],
      "properties": {
        "score": { "type": "null" },
        "assessmentCoverage": { "const": 0 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "outcome", "message", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]{2}-[A-Z]{2}-[0-9]{2}$" },
          "severity": { "enum": ["gate", "warning"] },
          "outcome": { "enum": ["pass", "fail", "unassessed", "not-applicable"] },
          "message": { "type": "string", "minLength": 1 },
          "remediation": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provisional", "type", "path", "value"],
              "properties": {
                "provisional": { "const": true },
                "type": { "enum": ["readme-span", "repository-fact"] },
                "path": { "type": "string", "minLength": 1 },
                "line": { "type": "integer", "minimum": 1 },
                "value": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
